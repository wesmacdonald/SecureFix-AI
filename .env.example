# SecureFix AI - Environment Configuration Example
# NEVER commit .env or real secrets. Use this file as a template only.

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Authentication
# Supported values: demo (local/dev only), entra (required when ASPNETCORE_ENVIRONMENT=Production)
AUTH_MODE=demo
# Required when AUTH_MODE=entra. Values come from the Microsoft Entra ID app registration.
# AzureAd__TenantId=<entra-tenant-id>
# AzureAd__ClientId=<app-registration-client-id>
# AzureAd__Audience=api://<app-registration-client-id>
# Used only by the demo authentication handler (AUTH_MODE=demo). Never set in Production.
SECUREFIX_DEMO_TOKEN=securefix-demo-token

# Dashboard build configuration (public values; never place secrets in VITE_* variables)
VITE_DATA_MODE=live
VITE_AUTH_MODE=demo
# Required for a production Entra dashboard build:
# VITE_ENTRA_CLIENT_ID=<single-page-application-client-id>
# VITE_ENTRA_TENANT_ID=<entra-tenant-id>
# VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
# VITE_ENTRA_REDIRECT_URI=https://securefix.example.com

# Database
DATABASE_URL=sqlite:securefix.db
DATABASE_PROVIDER=sqlite

# AI Provider Configuration
# Supported values: mock, azure-ai-foundry, rules-based-fallback
AI_PROVIDER=mock
# For Azure AI Foundry (OpenAI-compatible Responses API):
# AI_PROVIDER=azure-ai-foundry
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/openai/v1
# AZURE_AI_FOUNDRY_KEY=your-secret-key
# AZURE_AI_FOUNDRY_MODEL_ID=your-model-deployment-name
# To run the live Foundry integration test, set RUN_FOUNDRY_INTEGRATION_TESTS=true.
# For OpenAI:
# OPENAI_API_KEY=sk-xxxx

# Policy and Configuration
POLICY_APPROVAL_REQUIRED=true
POLICY_REVIEWER_ROLES=SecurityReviewer
POLICY_CRITICAL_MINIMUM_SCORE=90
POLICY_HIGH_MINIMUM_SCORE=70
POLICY_MEDIUM_MINIMUM_SCORE=40
POLICY_ALLOWED_PROVIDERS=mock,azure-ai-foundry,rules-based-fallback
POLICY_AI_TIMEOUT_SECONDS=30
POLICY_KILL_SWITCH_ENABLED=false

# Logging
LOG_LEVEL=Information
SERILOG_USING=Serilog.Sinks.Console

# Security
ENABLE_SECURITY_HEADERS=true
MAX_PAYLOAD_SIZE_BYTES=1048576
