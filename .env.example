# SecureFix AI - Environment Configuration Example
# NEVER commit .env or real secrets. Use this file as a template only.

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Database
DATABASE_URL=sqlite:securefix.db
DATABASE_PROVIDER=sqlite

# AI Provider Configuration
AI_PROVIDER=mock
# For Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=https://yourinstance.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-secret-key
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# For OpenAI:
# OPENAI_API_KEY=sk-xxxx

# Policy and Configuration
POLICY_APPROVAL_REQUIRED=true
POLICY_REVIEWER_ROLES=SecurityReviewer
POLICY_CRITICAL_MINIMUM_SCORE=90
POLICY_HIGH_MINIMUM_SCORE=70
POLICY_MEDIUM_MINIMUM_SCORE=40
POLICY_ALLOWED_PROVIDERS=mock,azure-openai
POLICY_AI_TIMEOUT_SECONDS=30
POLICY_KILL_SWITCH_ENABLED=false

# Logging
LOG_LEVEL=Information
SERILOG_USING=Serilog.Sinks.Console

# Security
ENABLE_SECURITY_HEADERS=true
MAX_PAYLOAD_SIZE_BYTES=1048576
