{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "canadacentral"
    },
    "containerAppName": {
      "value": "securefix-api"
    },
    "managedEnvironmentName": {
      "value": "securefix-environment"
    },
    "logAnalyticsWorkspaceName": {
      "value": "securefix-logs"
    },
    "containerRegistryName": {
      "value": "<existing-acr-name>"
    },
    "imageTag": {
      "value": "<image-tag>"
    },
    "demoToken": {
      "value": "<only-required-if-authMode-is-demo>"
    },
    "authMode": {
      "value": "entra"
    },
    "azureAdTenantId": {
      "value": "<entra-tenant-id>"
    },
    "azureAdClientId": {
      "value": "<app-registration-client-id>"
    },
    "azureAdAudience": {
      "value": "api://<app-registration-client-id>"
    }
  }
}
